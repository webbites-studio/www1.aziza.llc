{
  "name": "aziza1.webbites.dev",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "public/index.html",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start": "browser-sync start --server public --files public --single",
    "dev": "browser-sync start --server public --files public --single --port 3000 --no-notify",
    "lint": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^25",
    "browser-sync": "^3",
    "typescript": "^7"
  }
}